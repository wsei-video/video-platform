{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "test",
  "testEnvironment": "node",
  "testRegex": ".test.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@video/lib(|/.*)$": "<rootDir>/../../../libs/video-lib/src/$1"
  },
  "collectCoverage": true,
  "verbose": true,
  "globalSetup": "<rootDir>/testing/setup.ts",
  "globalTeardown": "<rootDir>/testing/teardown.ts",
  "setupFilesAfterEnv": ["<rootDir>/testing/database.ts"]
}
