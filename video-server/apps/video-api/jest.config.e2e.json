{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/test/**/*.test.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@video/lib(|/.*)$": "<rootDir>/../../libs/video-lib/src/$1"
  },
  "collectCoverage": true,
  "verbose": true,
  "globalSetup": "<rootDir>/test/testing/setup.ts",
  "globalTeardown": "<rootDir>/test/testing/teardown.ts",
  "setupFilesAfterEnv": ["<rootDir>/test/testing/database.ts"]
}
