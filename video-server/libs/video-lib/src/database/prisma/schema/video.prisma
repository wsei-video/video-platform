model Video {
  id           Int             @id @default(autoincrement())
  title        String
  description  String          @default("")
  duration     Int             @default(0)
  views        Int             @default(0)
  status       VideoStatus     @default(none)
  visibility   VideoVisibility @default(public)
  channelId    Int
  createdAt    DateTime        @default(now())
  hlsUrl       String?
  thumbnail    String?
  sourceName   String?
  sourceSize   Int?
  sourceKey    String?
  sourceUserId Int?

  reactions  VideoReaction[]
  comments   Comment[]
  videoStreams VideoStream[]
  audioStreams AudioStream[]

  channel    Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sourceUser Account?        @relation(fields: [sourceUserId], references: [id], onDelete: SetNull)
}

enum VideoVisibility {
  public
  private
  unlisted
}

enum VideoStatus {
  none
  processing
  successful
  failed
}
