model Account {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  accountChannelConnections AccountChannelConnection[]
  authSessions              AuthSession[]
  videoReactions            VideoReaction[]
  commentReactions          CommentReaction[]
  comments                  Comment[]
}
