{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/video-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/video-api/tsconfig.app.json"
  },
  "generateOptions": {
    "spec": false
  },
  "monorepo": true,
  "root": "apps/video-api",
  "projects": {
    "video-api": {
      "type": "application",
      "root": "apps/video-api",
      "entryFile": "main",
      "sourceRoot": "apps/video-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/video-api/tsconfig.app.json"
      }
    },
    "video-cdn": {
      "type": "application",
      "root": "apps/video-cdn",
      "entryFile": "main",
      "sourceRoot": "apps/video-cdn/src",
      "compilerOptions": {
        "tsConfigPath": "apps/video-cdn/tsconfig.app.json"
      }
    },
    "video-lib": {
      "type": "library",
      "root": "libs/video-lib",
      "entryFile": "index",
      "sourceRoot": "libs/video-lib/src",
      "compilerOptions": {
        "tsConfigPath": "libs/video-lib/tsconfig.lib.json"
      }
    },
    "video-processor": {
      "type": "application",
      "root": "apps/video-processor",
      "entryFile": "main",
      "sourceRoot": "apps/video-processor/src",
      "compilerOptions": {
        "tsConfigPath": "apps/video-processor/tsconfig.app.json"
      }
    },
    "video-upload": {
      "type": "application",
      "root": "apps/video-upload",
      "entryFile": "main",
      "sourceRoot": "apps/video-upload/src",
      "compilerOptions": {
        "tsConfigPath": "apps/video-upload/tsconfig.app.json"
      }
    }
  }
}